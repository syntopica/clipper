{
  "name": "brain-clipper",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "e2e": "pnpm build && playwright test -c e2e/playwright.config.ts",
    "store:zip": "pnpm build && node scripts/package-store.mjs"
  },
  "dependencies": {
    "any-ascii": "^0.3.3",
    "defuddle": "^0.19.5",
    "dompurify": "^3.4.17",
    "js-yaml": "^5.5.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
